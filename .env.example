# Supabase — get from: supabase.com → your project → Settings → API
REACT_APP_SUPABASE_URL=https://xxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGci...

# Supabase DB password (used only by Supabase CLI for migrations)
SUPABASE_DB_PASSWORD=your-db-password-here

# Stripe — get from: stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_1ABC...
STRIPE_WEBHOOK_SECRET=whsec_...

# Anthropic API key goes into Supabase secrets, NOT here
